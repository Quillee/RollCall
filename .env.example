# Backend (Go). Copy to .env and fill in.
#
# Go does not read .env files. These must be present in the server's process
# environment — exported by your shell, by the Makefile, or by the runtime
# (Docker --env-file, fly secrets) in production.

# BoardGameGeek API token, for wishlist fetching (TASKS.md Phase 1).
BGG_API_TOKEN=

# Port the HTTP server binds to. Defaults to 8080 when unset.
PORT=8080
